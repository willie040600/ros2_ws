#!/usr/bin/env python3
import curses
import time

from geometry_msgs.msg import Twist
import rclpy
from rclpy.node import Node


DIRECTIONS = {
    ord("w"): (0.10, 0.0),
    ord("s"): (-0.08, 0.0),
    ord("a"): (0.0, 0.30),
    ord("d"): (0.0, -0.30),
    ord("W"): (0.10, 0.0),
    ord("S"): (-0.08, 0.0),
    ord("A"): (0.0, 0.30),
    ord("D"): (0.0, -0.30),
    curses.KEY_UP: (0.10, 0.0),
    curses.KEY_DOWN: (-0.08, 0.0),
    curses.KEY_LEFT: (0.0, 0.30),
    curses.KEY_RIGHT: (0.0, -0.30),
}


def keyboard(screen, publisher):
    screen.keypad(True)
    screen.timeout(50)

    active_until = 0.0
    motion = (0.0, 0.0)
    while rclpy.ok():
        height, width = screen.getmaxyx()
        if height >= 2 and width >= 2:
            screen.erase()
            screen.addnstr(0, 0, "WASD / arrows: move | Space: stop | Q: quit", width - 1)
            state = "Drive connected" if publisher.get_subscription_count() else "Drive disabled or offline"
            screen.addnstr(1, 0, state, width - 1)
            screen.refresh()
        key = screen.getch()
        if key in (ord("q"), ord("Q"), 27):
            return
        if key in DIRECTIONS:
            motion = DIRECTIONS[key]
            active_until = time.monotonic() + 0.25
        elif key != -1:
            active_until = 0.0
        linear, angular = motion if time.monotonic() < active_until else (0.0, 0.0)
        message = Twist()
        message.linear.x = linear
        message.angular.z = angular
        publisher.publish(message)


def main():
    rclpy.init()
    node = Node("keyboard_teleop")
    publisher = node.create_publisher(Twist, "keyboard/cmd_vel", 1)
    try:
        curses.wrapper(keyboard, publisher)
    except KeyboardInterrupt:
        pass
    finally:
        if rclpy.ok():
            publisher.publish(Twist())
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == "__main__":
    main()

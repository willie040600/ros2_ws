#!/usr/bin/env python3
import math
import time

from geometry_msgs.msg import Quaternion, TransformStamped, Twist
from nav_msgs.msg import Odometry
import rclpy
from rclpy.executors import ExternalShutdownException
from rclpy.node import Node
import serial
from tf2_ros import TransformBroadcaster


def crc(data):
    value = 0xffff
    for byte in data:
        value ^= byte
        for _ in range(8):
            value = (value >> 1) ^ (0xa001 if value & 1 else 0)
    return value.to_bytes(2, "little")


def read_rpm(port, address):
    request = bytes([address, 3, 6, 100, 0, 1])
    port.reset_input_buffer()
    port.write(request + crc(request))
    # The TECO firmware returns status, signed RPM and voltage for this register.
    reply = port.read(11)
    if len(reply) != 11 or reply[:3] != bytes([address, 3, 6]) or reply[-2:] != crc(reply[:-2]):
        raise ValueError(f"Invalid wheel feedback from TECO address {address}")
    return int.from_bytes(reply[5:7], "big", signed=True)


def motor_frame(right, left):
    frame = bytearray.fromhex("00 65 02 01 03 02 01 00 00 02 03 02 01 00 00")
    for offset, rpm in ((7, right), (13, left)):
        command = min(4000, max(-4000, round(rpm)))
        if abs(command) < 5:
            command = 0
        frame[offset:offset + 2] = command.to_bytes(2, "big", signed=True)
    return frame + crc(frame)


class TecoOdometry(Node):
    def __init__(self):
        super().__init__("odom_control")
        self.declare_parameter("port", "/dev/ttyS0")
        self.declare_parameter("baudrate", 57600)
        self.declare_parameter("wheel_separation", 0.33)
        self.declare_parameter("wheel_diameter", 0.1524)
        self.declare_parameter("gear_ratio", 33.0)
        self.declare_parameter("enable_drive", False)
        self.declare_parameter("publish_tf", True)
        self.drive_enabled = self.get_parameter("enable_drive").value
        self.command = (0.0, 0.0)
        self.command_time = 0.0
        self.moving = False
        if self.drive_enabled:
            self.drive_subscription = self.create_subscription(
                Twist, "keyboard/cmd_vel", self.receive_command, 1)
        separation = self.get_parameter("wheel_separation").value
        diameter = self.get_parameter("wheel_diameter").value
        ratio = self.get_parameter("gear_ratio").value
        if not all(math.isfinite(value) and value > 0 for value in (separation, diameter, ratio)):
            raise ValueError("Wheel dimensions and gear ratio must be positive and finite")
        self.separation = separation
        self.metres_per_rpm = math.pi * diameter / (60.0 * ratio)
        self.port = serial.Serial(
            baudrate=self.get_parameter("baudrate").value,
            timeout=0.02, write_timeout=0.02, exclusive=True,
        )
        self.port.dtr = False
        self.port.rts = False
        self.port.port = self.get_parameter("port").value
        self.publisher = self.create_publisher(Odometry, "odom", 10)
        self.broadcaster = (
            TransformBroadcaster(self) if self.get_parameter("publish_tf").value else None
        )
        self.x = self.y = self.yaw = 0.0
        self.last_time = None
        self.reconnect_after = 0.0
        self.create_timer(0.04, self.update)

    def receive_command(self, message):
        linear = message.linear.x
        angular = message.angular.z
        if not math.isfinite(linear) or not math.isfinite(angular):
            linear = angular = 0.0
        self.command = (min(0.12, max(-0.12, linear)), min(0.35, max(-0.35, angular)))
        self.command_time = time.monotonic()

    def send_drive(self, linear, angular):
        if not self.drive_enabled or not self.port.is_open:
            return
        moving = bool(linear or angular)
        if moving or self.moving:
            half_turn = angular * self.separation / 2.0
            self.moving = True
            self.port.write(motor_frame(
                (linear + half_turn) / self.metres_per_rpm,
                -(linear - half_turn) / self.metres_per_rpm))
            self.moving = moving

    def stop(self):
        self.command = (0.0, 0.0)
        self.command_time = 0.0
        try:
            self.send_drive(0.0, 0.0)
        except OSError as error:
            self.get_logger().error(f"Could not send wheel stop: {error}")

    def update(self):
        try:
            if not self.port.is_open:
                if time.monotonic() < self.reconnect_after:
                    return
                self.port.open()
            right = read_rpm(self.port, 1) * self.metres_per_rpm
            left = -read_rpm(self.port, 2) * self.metres_per_rpm
            if self.drive_enabled:
                command = self.command if time.monotonic() - self.command_time <= 0.35 else (0.0, 0.0)
                self.send_drive(*command)
        except (OSError, ValueError) as error:
            self.last_time = None
            self.stop()
            self.get_logger().warning(str(error), throttle_duration_sec=5.0)
            if isinstance(error, OSError):
                self.port.close()
                self.reconnect_after = time.monotonic() + 1.0
            return

        now = self.get_clock().now()
        linear = (right + left) / 2.0
        angular = (right - left) / self.separation
        dt = (now - self.last_time).nanoseconds / 1e9 if self.last_time is not None else 0.0
        self.last_time = now
        if 0.0 < dt < 0.25:
            self.x += linear * dt * math.cos(self.yaw + angular * dt / 2.0)
            self.y += linear * dt * math.sin(self.yaw + angular * dt / 2.0)
            self.yaw = math.remainder(self.yaw + angular * dt, 2.0 * math.pi)

        orientation = Quaternion(z=math.sin(self.yaw / 2.0), w=math.cos(self.yaw / 2.0))
        odom = Odometry()
        odom.header.stamp = now.to_msg()
        odom.header.frame_id = "odom"
        odom.child_frame_id = "base_link"
        odom.pose.pose.position.x = self.x
        odom.pose.pose.position.y = self.y
        odom.pose.pose.orientation = orientation
        odom.twist.twist.linear.x = linear
        odom.twist.twist.angular.z = angular
        for covariance in (odom.pose.covariance, odom.twist.covariance):
            for index, variance in zip((0, 7, 14, 21, 28, 35), (0.01, 0.01, 1e3, 1e3, 1e3, 0.05)):
                covariance[index] = variance
        self.publisher.publish(odom)

        if self.broadcaster is None:
            return

        transform = TransformStamped()
        transform.header = odom.header
        transform.child_frame_id = odom.child_frame_id
        transform.transform.translation.x = self.x
        transform.transform.translation.y = self.y
        transform.transform.rotation = orientation
        self.broadcaster.sendTransform(transform)


def main():
    rclpy.init()
    node = None
    try:
        node = TecoOdometry()
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        if node is not None:
            node.stop()
            node.port.close()
            node.destroy_node()
        rclpy.try_shutdown()


if __name__ == "__main__":
    main()
